<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- TRPG.Data is entity models (plain data holders, no branching logic) plus EF
               Core schema config and migrations. Correctness there is already proven by
               every other test in the suite failing if the schema/mappings were wrong, the
               same reasoning that puts DI wiring and Program.cs out of scope for coverage. -->
          <Exclude>[TRPG.Data]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
