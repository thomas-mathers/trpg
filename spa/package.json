{
  "name": "trpg-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check",
    "generate-client": "dotnet build ../api/TRPG/TRPG.csproj -v minimal && dotnet build ../api/TRPG/TRPG.csproj -v minimal --no-restore -t:GenerateOpenApiDocuments && openapi-ts && dotnet tool run dotnet-tsrts --project ../api/TRPG/TRPG.csproj --output ./src/api/signalr-client --enum Union",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@faker-js/faker": "^10.5.0",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@microsoft/signalr": "^10.0.0",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "motion": "^13.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@storybook/react-vite": "^10.5.7",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.75.0",
    "storybook": "^10.5.7",
    "testing-library-selector": "^0.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
