<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Temporary: local fork (vendor/, gitignored) with disabled-item support for
         SelectionPrompt, pending https://github.com/spectreconsole/spectre.console/discussions/2179.
         Revert to the Spectre.Console NuGet package once that lands upstream. -->
    <ProjectReference Include="..\vendor\spectre.console\src\Spectre.Console\Spectre.Console.csproj" />
    <ProjectReference Include="..\TRPG.Client.Core\TRPG.Client.Core.csproj" />
    <ProjectReference Include="..\TRPG.Contracts\TRPG.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <PackageReference Include="ZLogger" Version="2.5.10" />
  </ItemGroup>
</Project>
